#!/usr/bin/env bash
# Builds Astrolog 8.00 from the checksum-pinned archive on astrolog.org and
# installs it under PREFIX (default ~/.local): the same recipe as the
# Dockerfile's first stage, for a machine that is not a container (CI, a
# developer without Docker). The archive is verified before it is unzipped.
set -Eeuo pipefail
PREFIX=${PREFIX:-$HOME/.local}
ARCHIVE=ast80src.zip
SHA256=8c0c33eac2c40d158c007f3a4168516972c9fc78830f65eba38ac2be46541d63
URL="https://www.astrolog.org/ftp/$ARCHIVE"
# 1200-1800 ephemeris files: swisseph repository at a pinned commit, one file each.
SWE_COMMIT=c69c14adb7a0f94829586ffd92cd422aacb21e86
SWE_URL="https://raw.githubusercontent.com/aloistr/swisseph/$SWE_COMMIT/ephe"
SWE_FILES="sepl_12.se1:8dccace2557601a223d5f8a7cf64de4e6bbb8a82b9b130b95a54d49adfbe546d semo_12.se1:1c65fdbb854f350d3de36afc3e4ac126a53f360ae4f6dcb57beed7c690e7eb61 seas_12.se1:3345555097e2080f4e2582026a6008ebbccfdca27600ba48019ca9c6e3e7a211"
work=$(mktemp -d); trap 'rm -rf "$work"' EXIT
cache=${ASTROLOG_CACHE:-$HOME/.cache/astrolog}
mkdir -p "$cache" "$PREFIX/bin" "$PREFIX/share/astrolog"
[ -f "$cache/$ARCHIVE" ] || curl -fsSL -o "$cache/$ARCHIVE" "$URL"
printf '%s  %s\n' "$SHA256" "$cache/$ARCHIVE" | sha256sum -c -
for e in $SWE_FILES; do
  n=${e%%:*}
  [ -f "$cache/$n" ] || curl -fsSL -o "$cache/$n" "$SWE_URL/$n"
  printf '%s  %s\n' "${e#*:}" "$cache/$n" | sha256sum -c -
done
unzip -q "$cache/$ARCHIVE" -d "$work"
cd "$work"
sed -i 's|^#define X11|//#define X11|' astrolog.h
sed -i "s|^#define DEFAULT_DIR \"\"|#define DEFAULT_DIR \"$PREFIX/share/astrolog\"|" astrolog.h
sed -i 's|-lX11||' Makefile
make -j"$(nproc)" >/dev/null
install -m 0755 astrolog "$PREFIX/bin/astrolog"
install -m 0644 astrolog.as atlas.as timezone.as sefstars.txt seorbel.txt "$PREFIX/share/astrolog/"
install -m 0644 ephem/sepl_18.se1 ephem/semo_18.se1 ephem/seas_18.se1 "$PREFIX/share/astrolog/"
# Numbered-asteroid and dwarf-planet files (the Bodies chooser marks a body
# whose file is absent), then the 1200-1800 files for charts before 1800.
(cd ephem && install -m 0644 se00010s.se1 se50000s.se1 se90377s.se1 se90482s.se1 \
  s136108s.se1 s136199s.se1 s136472s.se1 s225088s.se1 "$PREFIX/share/astrolog/")
for e in $SWE_FILES; do install -m 0644 "$cache/${e%%:*}" "$PREFIX/share/astrolog/"; done
"$PREFIX/bin/astrolog" -Hc | grep -F 'Astrolog version 8.00' >/dev/null
"$PREFIX/bin/astrolog" -qa 6 15 1990 14:30 5:00 122W 37N | grep -q '^Sun :.*Gem'
! "$PREFIX/bin/astrolog" -qa 6 15 1500 12:00 0:00 0W 51N -R0 11 2>&1 | grep -q 'not found'
! "$PREFIX/bin/astrolog" -qa 6 15 1990 14:30 5:00 122W 37N -R0 43 2>&1 | grep -q 'not found'
echo "astrolog 8.00 installed in $PREFIX/bin (data in $PREFIX/share/astrolog)"
